# AlgoLens Server Configuration
PORT=5000
NODE_ENV=development

# Database Path (optional, defaults to backend/data/algolens.db)
# In production, point this to your persistent volume mount
DATABASE_PATH=backend/data/algolens.db

# Authentication & JWT Secrets
# REQUIRED in production mode! Must be a cryptographically random string (minimum 32 chars).
# Example command to generate: openssl rand -base64 48
# Server will REFUSE to boot in production if JWT_SECRET is unset or matches an example string.
JWT_SECRET=your_development_secret_here_replace_for_production

# Client URL (for CORS & OAuth callbacks)
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 (Continue with Google)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Email Verification (OTP Dispatch via SMTP)
# Example for Gmail: set SMTP_HOST=smtp.gmail.com, SMTP_USER, and a 16-char Gmail App Password.
# In local development without SMTP credentials, OTP codes are printed to the server console.
EMAIL_FROM=AlgoLens <noreply@algolens.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Gemini AI Tutor & Adversarial Edge-Case Generator (Small-Scale Budget Controls)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_USER_DAILY_CAP=10
GEMINI_GLOBAL_DAILY_CAP=80
GEMINI_MAX_OUTPUT_TOKENS=420
GEMINI_CACHE_TTL_MS=900000

# Isolated Java JDI Trace Worker
JAVA_TRACE_WORKER_URL=http://127.0.0.1:5050
