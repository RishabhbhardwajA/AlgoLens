# AlgoLens Server Configuration
PORT=5000
NODE_ENV=development

# Database Path (optional, defaults to backend/data/algolens.db)
# In production, point this to your persistent volume mount
DATABASE_PATH=backend/data/algolens.db

# Authentication & JWT Secrets
# REQUIRED in production mode! Must be a cryptographically random string (minimum 32 chars).
# Example command to generate: openssl rand -base64 48
# Server will REFUSE to boot in production if JWT_SECRET is unset or matches an example string.
JWT_SECRET=your_development_secret_here_replace_for_production

# Client URL (for CORS headers)
CLIENT_URL=http://localhost:5173
