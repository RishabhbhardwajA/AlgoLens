{
  "name": "algolens-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "build:tracer": "javac --add-modules jdk.jdi -d dist/tracer/java src/tracer/java/com/algolens/tracer/JavaTracer.java",
    "build": "tsc && npm run build:tracer",
    "start:worker": "node dist/tracer/java/worker/server.js",
    "test": "tsx tests/auth.test.ts && tsx tests/api.test.ts && tsx tests/execution.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
