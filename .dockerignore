# Git metadata
.git
.gitignore

# Dependencies (installed fresh in Docker builder stage)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts (rebuilt inside Docker builder stage)
dist/
frontend/dist/
backend/dist/

# Local Environment & Secrets (NEVER bake credentials into image)
.env
.env.local
.env.development
.env.production
!.env.example

# SQLite Database & Backups (NEVER bake live databases into container layers; mount via volume)
*.db
*.db-wal
*.db-shm
*.db.backup
backend/data/*.db*
backend/src/database/*.db*

# IDE & Tooling Caches
.vscode/
.idea/
.gemini/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
